/* ============================================================
   AKAI SDS - stylesheet TEMPLATE
   ------------------------------------------------------------
   This is not a plain .qss file - it's a template. Every color
   is a dollar-brace placeholder instead of a literal hex code, filled in
   by ui/theme.py's DARK_PALETTE or LIGHT_PALETTE at load time
   (see render_stylesheet() there).

   Edit the STRUCTURE here (selectors, spacing, borders-widths,
   which properties exist) - edit the ACTUAL COLORS in
   ui/theme.py instead, so both the dark and light theme stay
   in lockstep automatically.
   ============================================================ */

/* ---------- Base ---------- */
QWidget {
    background-color: ${bg};
    color: ${text};
    font-size: 13px;
}

QMainWindow {
    background-color: ${bg};
}

QLabel {
    background: transparent;
    color: ${text};
}

/* ---------- Buttons ---------- */
QPushButton {
    background-color: ${bg_button};
    border: 1px solid ${border};
    border-radius: 4px;
    padding: 5px 12px;
    color: ${text};
}

QPushButton:hover {
    background-color: ${bg_button_hover};
    border-color: ${border_hover};
}

QPushButton:pressed {
    background-color: ${bg_button_pressed};
}

QPushButton:disabled {
    background-color: ${bg_disabled};
    border-color: ${border_disabled};
    color: ${text_disabled};
}

/* checkable buttons used as a segmented control (e.g. the zone selector) -
   the checked one should read as "currently selected", not just "toggled on" */
QPushButton:checked {
    background-color: ${accent};
    border-color: ${accent};
    color: ${text_on_accent};
}

QPushButton:checked:hover {
    background-color: ${accent};
}

/* ---------- Line edits (queue row names, dialog fields) ---------- */
QLineEdit {
    background-color: ${bg_input};
    border: 1px solid ${accent};
    border-radius: 3px;
    padding: 2px 4px;
    color: ${text_bright};
    selection-background-color: ${accent};
}

QLineEdit:read-only {
    background: transparent;
    border: 1px solid transparent;
    color: ${text};
}

QLineEdit:disabled {
    color: ${text_disabled};
}

/* ---------- Lists (file queue + hardware panel) ---------- */
QListWidget {
    background-color: ${bg_panel};
    border: 1px solid ${border_list};
    border-radius: 4px;
    outline: none;
}

QListWidget::item {
    border-bottom: 1px solid ${border_item};
}

QListWidget::item:selected {
    background-color: ${bg_selected};
}

/* Program editor's Programs and Samples lists (plain text rows, no
   per-row buttons) - scoped by objectName rather than widening
   QListWidget::item generally, since the dashboard's queue/hardware rows
   (and the keygroup list's own swatch+label rows) already get their own
   comfortable height from the custom row widget's own margins and don't
   need extra item padding stacked on top. */
QListWidget#programList::item,
QListWidget#sampleList::item {
    padding: 6px 8px;
}

/* Program editor's zone card (Zone 1-4 selector + that zone's controls) -
   same surface/border pair as the list panels above, so it reads as a
   distinct card without introducing a new color */
QWidget#zoneCard {
    background-color: ${bg_panel};
    border: 1px solid ${border};
    border-radius: 4px;
}

/* Program tab's grouped sections (Volume/Pan/Velocity, LFO, Pitch, ...) -
   same card treatment as the zone card above, under its own objectName
   since this isn't zone content */
QWidget#sectionCard {
    background-color: ${bg_panel};
    border: 1px solid ${border};
    border-radius: 4px;
}

QLabel#sectionHeader {
    color: ${text_bright};
    font-weight: 600;
    background: transparent;
}

/* placeholder text shown when file transfer queue is empty */
#emptyQueueLabel {
  color: ${text_disabled};
  font-style: italic;
  font-size: 14px;
  background: transparent;
}

/* ---------- Checkboxes (hardware panel rows) ---------- */
QCheckBox {
    background: transparent;
    color: ${text};
    spacing: 6px;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid ${border_checkbox};
    border-radius: 3px;
    background: ${bg_input};
}

QCheckBox::indicator:checked {
    background: ${accent};
    border-color: ${accent};
    image: url(${checkmark_icon});
}

/* ---------- Progress bars ---------- */
QProgressBar {
    background-color: ${bg_disabled};
    border: 1px solid ${border_progress};
    border-radius: 4px;
    text-align: center;
    color: ${text};
}

QProgressBar::chunk {
    background-color: ${accent};
    border-radius: 3px;
}

QProgressBar[memoryLevel="warning"]::chunk {
  background-color: ${warning};
}

QProgressBar[memoryLevel="critical"]::chunk {
  background-color: ${critical};
}
/* ---------- Status bar ---------- */
QStatusBar {
    background-color: ${bg_statusbar};
    color: ${text_statusbar};
}

/* ---------- Dialogs (Edit sample, Global settings, MIDI settings) ---------- */
QDialog {
    background-color: ${bg_dialog};
}

QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: ${bg_input};
    border: 1px solid ${border};
    border-radius: 3px;
    padding: 2px 4px;
    color: ${text_bright};
}

/* QSpinBox/QDoubleSpinBox naturally render taller than QComboBox even with
   identical padding above - Fusion reserves extra vertical room for their
   stacked up/down buttons that a combo box's single drop-down arrow
   doesn't need. Pinned to match by measurement (offscreen, this theme's
   fonts): unstyled QSpinBox.sizeHint().height() == 29px; a QComboBox
   sitting next to one (e.g. the Portamento card's Type combo next to its
   Rate spinbox) read visibly shorter without this. min-height is
   content-box height here (border/padding add on top, same as the shared
   rule above), so this is NOT simply "29" - re-measure with
   QComboBox.sizeHint() if this ever needs adjusting again. */
QComboBox {
    min-height: 23px;
}

QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: ${border_hover};
}

QComboBox QAbstractItemView {
    background-color: ${bg_input};
    color: ${text_bright};
    selection-background-color: ${accent};
    border: 1px solid ${border};
}

QComboBox QAbstractItemView::item {
  padding: 4px 6px;
}

QComboBox QAbstractItemView::item:selected {
  background-color: ${accent};
  color: ${text_on_accent};
}

QComboBox::drop-down {
  subcontrol-origin: padding;
  subcontrol-position: top right;
  width: 22px;
  border: none;
  background: transparent;
}

QComboBox::down-arrow {
  image: url(${down_arrow_icon});
  width: 10px;
  height: 10px;
}

QComboBox::down-arrow:disabled {
  image: url(${down_arrow_icon_disabled})
}

QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
  subcontrol-origin: border;
  width: 16px;
  border: none;
  background: transparent;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
  image: url(${up_arrow_icon});
  width: 8px;
  height: 8px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
  image: url(${down_arrow_icon});
  width: 8px;
  height: 8px;
}

/* ------------------TABS (MIDI SETTINGS dialog) ---------------------------*/
/* The tab row reads as a single bordered strip - flush against the content
   pane below it, no gaps between tabs - with the whole strip's outer
   corners rounded to match the app's usual 4px radius (bottom corners stay
   square since that edge meets the pane). The selected tab uses the app's
   "selected" tint (bg_selected, also used for selected list rows) so it
   visibly pops instead of blending into whatever sits behind it. */
QTabWidget::pane {
  border: 1px solid ${border};
  border-top-left-radius: 0;
  border-top-right-radius: 0;
  border-bottom-left-radius: 4px;
  border-bottom-right-radius: 4px;
  top: -1px;
  background-color: ${bg_dialog};
}

QTabBar::tab {
    background-color: ${bg_button};
    border: 1px solid ${border};
    border-bottom: none;
    padding: 7px 16px;
    margin-left: -1px;
    color: ${text_statusbar};
}

QTabBar::tab:first {
    margin-left: 0;
    border-top-left-radius: 4px;
}

QTabBar::tab:last {
    border-top-right-radius: 4px;
}

QTabBar::tab:only-one {
    margin-left: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:hover {
    background-color: ${bg_button_hover};
    border-color: ${border_hover};
    color: ${text};
}

QTabBar::tab:selected {
    background-color: ${bg_selected};
    border-color: ${border_hover};
    color: ${text_bright};
}

/* ---------- Scrollbars ---------- */
/* thin, flat, overlay-style bars - no arrow buttons, no 3D bevel */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: ${border_hover};
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: ${accent};
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
    background: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: ${border_hover};
    border-radius: 5px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: ${accent};
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    border: none;
    background: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* ---------- Message boxes (delete confirmation) ---------- */
QMessageBox {
    background-color: ${bg_dialog};
}
